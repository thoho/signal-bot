[Unit]
Description=Signal Bot
After=network-online.target signal-api.service
Wants=network-online.target signal-api.service

[Service]
Type=simple
WorkingDirectory=%h/signal-bot
EnvironmentFile=%h/.config/signal-bot.env
ExecStart=%h/signal-bot/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
